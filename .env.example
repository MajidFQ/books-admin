# Copy this file to .env.local and fill in your own values.
# Never commit .env.local — it is listed in .gitignore.

# MongoDB connection string from MongoDB Atlas
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/

# Secret key used to sign JWT tokens — use a long, random string
# You can generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# Admin login credentials
ADMIN_USERNAME=admin

# bcrypt hash of the admin password
# Generate with: node -e "const b = require('bcryptjs'); console.log(b.hashSync('your_password', 10))"
ADMIN_PASSWORD_HASH=$2b$10$...
